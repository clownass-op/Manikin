# Template for supabase.key (the repo commits its own copy). Format: one
# `url=` line and one `key=` line. The publishable/anon key is only safe to
# publish when the table is read-only for anon (grants + RLS), see README.
url=https://YOUR-PROJECT.supabase.co/rest/v1/swfs
key=YOUR-PUBLISHABLE-ANON-KEY
