# Build output
bin/
obj/

# Visual Studio / user files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs and temp
*.log
*.tmp
*.bak
*.old
Desktop.ini
Thumbs.db

# Local dev scratch (harness, scripts, captures) - never commit
TestPlayer*.*
shot_*.png
crop_*.png
*.ps1

# Python
__pycache__/

# Optional local override for the catalog credentials - the key itself is
# compiled into Wardrobe.cs, so no file is needed (see README).
supabase.key

# GitHub write token for the catalog repo (Contents API). A published exe must
# not carry one, so it stays out of git.
github.key

# ffmpeg is fetched locally - too large for the repo (GitHub rejects >100 MB)
tools/ffmpeg.exe
